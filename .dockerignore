.git
.gitignore
.idea
.vscode
.claude
__pycache__
*.pyc
*.pyo
*.pyd
*.log
.venv
venv
data
deploy/docker/state
tests
.pytest_cache
newsbot.egg-info

# Environment files — never copy secrets into image layers
.env
.env.*
!.env.example
deploy/docker/.env
deploy/docker/.env.*

# SQLite databases — runtime state, not build artifacts
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# Credential files — never copy secrets into image layers
*.pem
*.key
*.p12
*.pfx
credentials.json
service_account.json
*.service-account.json
.npmrc
.pypirc
.netrc
.aws/
.gcloud/
.ssh/
.kube/
.docker/

# Models and binaries — huge, never needed in image
ollama_models/
*.gguf
*.bin
*.safetensors
models/

# OS / IDE / temp
.DS_Store
Thumbs.db
*.swp
*.tmp
*.bak
*.old
node_modules/
dist/
build/
logs/