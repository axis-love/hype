# News bot environment configuration
# Copy this file to .env and fill in the values.
# cp .env.example .env

# ── Telegram Bot ─────────────────────────────────────────────────
BOT_TOKEN=__FILL_ME__
NEWS_CHANNEL_ID=__FILL_ME__        # @channel_username or -100... chat id

# ── LLM endpoint (OpenAI-compatible) ────────────────────────────
# LM_BASE must include /v1 (e.g. https://muse.axis.love/v1)
LM_BASE=https://muse.axis.love/v1
LM_MODEL=gemma4:26b
LM_FILTER_MODEL=qwen3.6:27b
LM_API_KEY=__FILL_ME__
LM_TIMEOUT=300

# ── Reddit (required for real engagement counts; Devvit refresh token) ─
# Permanent, non-rotating token from a Devvit app.
# Get it from ~/.devvit/token (base64-JSON, key "refreshToken").
REDDIT_REFRESH_TOKEN=
# Client id used at the token endpoint. Leave blank for the Devvit CLI's
# public id; set only if Reddit rotates it.
REDDIT_CLIENT_ID=

# ── GitHub (optional, increases rate limit from 60 to 5000/hr) ───
GITHUB_TOKEN=

# ── Schedule (all times in NEWS_TZ) ────────────────────────────
# Wall-clock timezone for all schedules (default Asia/Bangkok)
NEWS_TZ=Asia/Bangkok
# Comma-separated local hours when a digest runs (catch-up fires once
# after downtime; default 5,9,13,17,21 — every 4 h from 05:00)
NEWS_GEN_HOURS=5,9,13,17,21
# Max raw rows kept in the store; coldest evicted after each digest (default 36)
NEWS_STORE_CAP=36

# ── Posting gate ────────────────────────────────────────────────
# Minimum raw temperature a story needs before it can be posted (default 35)
NEWS_TEMP_FLOOR=35
# Threshold = max(floor, ratio × median store temperature) (default 0.5)
NEWS_THRESHOLD_RATIO=0.5
# Ranking multiplier for merged stories: bonus per extra merge (default 0.2)
NEWS_MERGE_BONUS=0.2
# Cap on the merge multiplier (default 2.0)
NEWS_MERGE_CAP=2.0

# ── Bot Admin (for /setstyle, /digest, /post, /scores, /status, /summary commands) ─
# Your Telegram user ID (numeric). Get it from @userinfobot.
# Leave blank to disable bot commands.
ADMIN_USER_ID=
# Telegram user ID authorized to use bot commands (/digest, /post, /scores, /status, /summary, /setstyle, /style, /help)

# ── Storage ──────────────────────────────────────────────────────
NEWS_DB=data/newsbot.sqlite

# ── Logging ──────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── H4 Consumer HTTP API (optional) ─────────────────────────────
# Port for the consumer API. Unset = API disabled (default).
# When set, consumers (girllm, blog, etc.) can fetch ranked items and
# record deliveries via HTTP on the same event loop (no threads).
# HYPE_API_PORT=8080
# Comma-separated consumer:key pairs. Each key is a bearer token.
# Consumers must have a profile in _consumer_profiles() (config.py);
# unknown consumers get 403.
# HYPE_API_KEYS=girllm:<key>,blog:<key>