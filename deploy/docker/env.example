BOT_TOKEN=
ADMIN_IDS=
LOG_LEVEL=INFO
MAX_CONCURRENT=1

GIRLLM_DB_BASENAME=girllm.sqlite

LM_TIMEOUT=300
LM_BASE=
LM_MODEL=
JESSICA_OPENROUTER_API_KEY=

NATALIE_LM_TIMEOUT=300
NATALIE_LM_BASE=
NATALIE_LM_MODEL=
NATALIE_OPENROUTER_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=

NATALIE_API_ID=
NATALIE_API_HASH=
NATALIE_SESSION=
NATALIE_PHONE=

# Trend-based smart posts / memory compaction live in Natalie settings, not direct env vars.
# Configure them after boot from Jessica, for example:
# /p set trend_fetch_interval_hours 6
# /p set trend_digest_model google/gemini-2.0-flash-001
# /p set trend_digest_provider openrouter
# /p set memory_compact_interval_hours 24
# /p set trend_sources {"rss":[{"url":"https://feeds.bbci.co.uk/news/rss.xml","name":"BBC News"}]}

# /update command: disabled by default in Docker (no .git in image).
# Only set these if you wire /update to a host-level deploy helper.
UPDATE_PULL_COMMAND=disabled
UPDATE_RESTART_COMMAND=
