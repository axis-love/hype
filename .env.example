# News bot environment configuration
# Copy this file to .env and fill in the values.
# cp .env.example .env

# ── Telegram Bot ─────────────────────────────────────────────────
BOT_TOKEN=__FILL_ME__
NEWS_CHANNEL_ID=__FILL_ME__        # @channel_username or -100... chat id

# ── LLM endpoint (OpenAI-compatible) ────────────────────────────
LM_BASE=https://muse.axis.love/v1
LM_MODEL=gemma4:26b
LM_FILTER_MODEL=qwen3.6:27b
LM_API_KEY=__FILL_ME__
LM_TIMEOUT=300

# ── Product Hunt (optional, leave blank to skip PH collector) ────
PH_API_KEY=

# ── GitHub (optional, increases rate limit from 60 to 5000/hr) ───
GITHUB_TOKEN=

# ── Schedule ──────────────────────────────────────────────────
# Hours between generation cycles (default 8; set to 0 for one-shot)
NEWS_INTERVAL_HOURS=8
# Minutes between individual post deliveries (default 60)
NEWS_POST_INTERVAL_MINUTES=60

# ── Bot Admin (for /setstyle, /run, /status commands) ───────────
# Your Telegram user ID (numeric). Get it from @userinfobot.
# Leave blank to disable bot commands.
ADMIN_USER_ID=

# ── Storage ──────────────────────────────────────────────────────
NEWS_DB=data/newsbot.sqlite

# ── Logging ──────────────────────────────────────────────────────
# LOG_LEVEL=INFO