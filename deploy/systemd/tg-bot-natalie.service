[Unit]
Description=GirlLM Natalie worker
After=network-online.target
Wants=network-online.target
PartOf=girllm.target

[Service]
Type=simple
WorkingDirectory=%h/tg-bot
EnvironmentFile=-%h/tg-bot/deploy/systemd/girllm.env
Environment=REPO_DIR=%h/tg-bot
Environment=DEPLOY_MODE=systemd
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env python3 natalie_worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=girllm.target
