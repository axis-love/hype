# ── LLM endpoint (OpenAI-compatible) ─────────────────────────────
# LM_BASE must include /v1 (e.g. https://muse.axis.love/v1)
LM_BASE=
LM_MODEL=
LM_FILTER_MODEL=
LM_API_KEY=
LM_TIMEOUT=300

# ── Telegram (leave empty for dry-run mode) ──────────────────────
BOT_TOKEN=
NEWS_CHANNEL_ID=

# ── Product Hunt (optional; skips PH if unset) ───────────────────
PH_API_KEY=

# ── GitHub (optional; increases rate limit from 60 to 5000/hr) ───
GITHUB_TOKEN=

# ── Schedule ──────────────────────────────────────────────────────
# Hours between scheduled generation runs (default 8)
NEWS_INTERVAL_HOURS=8
# Minutes between individual post deliveries (default 60)
NEWS_POST_INTERVAL_MINUTES=60

# ── Bot Admin (for /setstyle, /digest, /post, /status commands) ──
# Your Telegram user ID (numeric). Get it from @userinfobot.
# Leave blank to disable bot commands.
ADMIN_USER_ID=

# ── Storage ──────────────────────────────────────────────────────
# NEWS_DB=/app/data/newsbot.sqlite  (set in compose.yml)

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO