[Unit]
Description=GirlLM Natalie DM gateway
After=network-online.target tg-bot-natalie.service
Wants=network-online.target
PartOf=girllm.target

[Service]
Type=simple
WorkingDirectory=%h/tg-bot
EnvironmentFile=-%h/tg-bot/deploy/systemd/girllm.env
Environment=REPO_DIR=%h/tg-bot
Environment=DEPLOY_MODE=systemd
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env python3 natalie_dm_gateway.py
Restart=always
RestartSec=5

[Install]
WantedBy=girllm.target
