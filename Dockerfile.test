FROM news-bot-newsbot:latest

USER root

# Install dev dependencies from pyproject.toml's [dev] extras.
# The prod image already has the package installed; this adds pytest +
# pytest-asyncio from the same pyproject that pins their versions.
COPY pyproject.toml /app/pyproject.toml
RUN pip install --no-cache-dir ".[dev]"

# Copy test suite (excluded from prod image by .dockerignore)
COPY tests/ /app/tests/

# Copy scripts (needed by migration tests)
COPY scripts/ /app/scripts/

WORKDIR /app
USER appuser
